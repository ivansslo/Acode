<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="com.foxdebug.acode.rk.rocaide"
    version="1.0.0">
    <name>RocAide</name>
    <description>Codex UI integration — manage and view Codex CLI web interface from Acode</description>

    <js-module name="RocAide" src="www/RocAide.js">
        <clobbers target="window.RocAide" />
    </js-module>

    <platform name="android">
        <config-file parent="/*" target="res/xml/config.xml">
            <feature name="RocAide">
                <param name="android-package" value="com.foxdebug.acode.rk.rocaide.RocAidePlugin" />
            </feature>
        </config-file>

        <source-file
            src="src/android/RocAidePlugin.java"
            target-dir="src/com/foxdebug/acode/rk/rocaide" />
    </platform>
</plugin>
